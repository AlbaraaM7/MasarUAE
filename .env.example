# ==============================================================================
# MASAR UAE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Note: Keep all real secrets in your local '.env.local' file or Vercel dashboard.
# Never commit credentials, private tokens, or service-role keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Safe to expose to browser)
# ------------------------------------------------------------------------------

# Production base URL for canonical tags, sitemaps, and absolute URLs.
# Source: Your custom domain or Vercel deployment URL (e.g., https://masaruae.com).
# Used by: SEO metadata, sitemap generator, and robots.txt.
NEXT_PUBLIC_SITE_URL=

# Supabase Project URL.
# Source: Supabase Dashboard -> Project Settings -> Data API -> Project URL.
# Used by: Client-side Supabase SDK and Auth in src/lib/supabase.ts.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous Public Key.
# Source: Supabase Dashboard -> Project Settings -> Data API -> Project API keys (anon / public).
# Used by: Browser-side client initialization and Row Level Security queries.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Never expose to browser or prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------

# AI Exam Coach API Keys (Optional: Intelligent fallback rubric is built-in).
# Source: Google AI Studio (aistudio.google.com) or OpenAI Platform (platform.openai.com).
# Used by: Server-side AI past paper grading engine (src/app/api/grade/route.ts).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Payment Gateway Secrets (Optional: $0 cost sandbox mode active by default).
# Source: Stripe Dashboard -> Developers -> API keys.
# Used by: Server-side Stripe checkout and webhook verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
